class Solution {
    static int n, m;
    static Integer dp[][][];
    public int maxPathScore(int[][] grid, int k) {
        n = grid.length;
        m = grid[0].length;
        dp = new Integer[n+1][m+1][k+1];
        return help(0, 0, 0, grid, k);
    }

    public int help(int r, int c, int cost, int grid[][], int k) {
        if (r < 0 || c < 0 || r >= n || c >= m) return -1;

        if (grid[r][c] == 1 || grid[r][c] == 2) {
            cost += 1;
        }

        if(cost > k) return -1;

        if(dp[r][c][cost] != null) return dp[r][c][cost];

        if(r == n-1 && c == m-1) return grid[r][c];



        int right = help(r, c + 1, cost,grid, k);
        int down = help(r + 1, c,cost, grid, k);

        int result = Math.max(right,down);

        if(result == -1) return dp[r][c][cost] =  -1;

        return dp[r][c][cost] = grid[r][c]+result;

    }
}
