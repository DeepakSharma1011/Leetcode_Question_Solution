class Solution {
    public int lengthOfLongestSubstring(String s) {
        int n = s.length();
        int l = 0, maxLen = 0;
        Map<Character, Integer> map = new HashMap<>();

        for (int h = 0; h < n; h++) {
            char c = s.charAt(h);
            if (map.containsKey(c)) {
                l = Math.max(l, map.get(c) + 1);
            }
            map.put(c, h);
            maxLen = Math.max(maxLen, h - l + 1);
        }

        return maxLen;
    }

}
