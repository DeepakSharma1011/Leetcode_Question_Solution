class Solution {
    public int minSteps(String s, String t) {
        int n = s.length();

        int arrs[] = new int[26];
        int arrt[] = new int[26];

        for(int i=0; i<n; i++){
            arrs[s.charAt(i)-'a']++;
            arrt[t.charAt(i)-'a']++;
        }

        int count = 0;
        for(int i = 0; i<26; i++){
            if(arrs[i] > arrt[i]){
                count += arrs[i]-arrt[i];
            }
        }

        return count;
    }
}
