class Solution {
    public int rotatedDigits(int n) {
        int c = 0;

        for(int i =1; i<=n; i++){
            if(isValid(i)){
                c++;
            }
        }

        return c;
    }
    public boolean isValid(int num){
        boolean d = false;

        while(num >0){
            int digit = num%10;

            if(digit == 3 || digit == 4 || digit == 7) return false;
            else if(digit == 2 || digit == 5 || digit == 6 || digit == 9) d = true;

            num /= 10;
        }

        return d;
    }
}
