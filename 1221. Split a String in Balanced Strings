class Solution {
    public int balancedStringSplit(String s) {
        int n = s.length();
        int balance = 0;
        int ans = 0;

        for(int i = 0; i<n; i++){
            if(s.charAt(i) == 'L') balance++;
            else if(s.charAt(i) == 'R'){
                balance--;
            }

            if(balance == 0) ans++;
        }
        return ans;
    }
}
