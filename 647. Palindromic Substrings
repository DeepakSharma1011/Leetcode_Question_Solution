class Solution {
    static int n;
    public int countSubstrings(String s) {
        n = s.length();
        int count = 0;
        for(int i=0; i<n; i++){
            count += expand(s,i,i);
            count += expand(s,i,i+1);
        }
        return count;
    }
    public int expand(String s, int l, int r){
        int c = 0;
        while(l >=0 && r < n && s.charAt(l) == s.charAt(r)){
            c++;
            l--; r++;
        }
        return c;
    }
}
