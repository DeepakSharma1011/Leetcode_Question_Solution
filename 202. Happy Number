class Solution {
    public boolean isHappy(int n) {
        int slow = n;
        int fast = n;
        while(true){
            slow = sS(slow);
            fast = sS(sS(fast));
            if(slow == fast){break;}
        }
        return slow == 1;
    }
    public int sS(int n){
        int sum = 0;
        while(n>0){
            int di = n%10;
            n /= 10;
            sum += di*di;
        }
        return sum;
    }
}
