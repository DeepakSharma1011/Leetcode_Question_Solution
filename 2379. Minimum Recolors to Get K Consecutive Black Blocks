class Solution {
    public int minimumRecolors(String blocks, int k) {
        int n = blocks.length();
        int mini = Integer.MAX_VALUE;
        for(int i = 0; i<=n-k; i++){
            int sum = 0;
            for(int j = i; j<i+k; j++){
                if(blocks.charAt(j) == 'W') sum++;
            }
            mini = Math.min(mini, sum);
        }

        return mini;
    }
}
